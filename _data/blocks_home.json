    "id": "cta",
    "nome": "CTA finale",
    "enabled": true,
    "html": "<section style=\"background:#ffffff;padding:5rem 1.5rem;text-align:center;border-top:1px solid #e4e2da\" aria-labelledby=\"cta-title\">\n  <div style=\"max-width:640px;margin:0 auto\">\n    <h2 id=\"cta-title\" style=\"font-family:'Archivo Narrow',sans-serif;font-weight:700;font-size:clamp(1.9rem,3.6vw,2.6rem);color:#1c2024;margin:0 0 1rem\">Facciamo crescere insieme il tuo business</h2>\n    <p style=\"font-size:1.05rem;line-height:1.6;color:#4a4f54;margin:0 0 2.25rem\">Compila il modulo o scrivici su WhatsApp: rispondiamo entro 24 ore, festivi esclusi.</p>\n    <div style=\"display:flex;gap:1rem;justify-content:center;flex-wrap:wrap\">\n      <a href=\"#\" style=\"font-family:'Archivo Narrow',sans-serif;font-weight:700;padding:.95rem 1.9rem;background:#1c2024;color:#ffffff;text-decoration:none;border-radius:2px\">Richiedi una consulenza</a>\n      <a href=\"#\" style=\"font-family:'Archivo Narrow',sans-serif;font-weight:700;padding:.95rem 1.9rem;border:1px solid #1c2024;color:#1c2024;text-decoration:none;border-radius:2px\">Scrivici su WhatsApp</a>\n    </div>\n  </div>\n</section>\n<style>\n@media(max-width:820px){\n  header section > div{grid-template-columns:1fr!important}\n  header section > div > div:last-child{border-left:none!important;padding-left:0!important;border-top:1px solid #e4e2da;padding-top:1.5rem;flex-direction:row!important;flex-wrap:wrap;gap:1.75rem!important}\n  .eext-2col{grid-template-columns:1fr!important;gap:2rem!important}\n  .eext-3col{grid-template-columns:1fr!important}\n  .eext-2col-flat{grid-template-columns:1fr!important}\n  .eext-2col-flat .eext-cell-r{border-right:none!important}\n  .eext-2col-flat > div{border-right:none!important}\n  .eext-pricing{flex-direction:column!important}\n  .eext-pricing .eext-cell-r{border-right:none!important;border-bottom:1px solid #e4e2da}\n}\n@media(max-width:480px){\n  section{padding-left:1.25rem!important;padding-right:1.25rem!important}\n}\n</style>"
