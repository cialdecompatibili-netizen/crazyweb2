    "id": "hero",
    "nome": "Hero",
    "enabled": true,
    "html": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link href=\"https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@500;600;700&display=swap\" rel=\"stylesheet\"><header><section style=\"background:#ffffff\" aria-label=\"Hero\"><div style=\"max-width:1180px;margin:0 auto;padding:2.75rem 1.5rem;display:grid;grid-template-columns:1.6fr 1fr;gap:3rem;align-items:center\"><div><h1 style=\"font-family:'Archivo Narrow',Arial Narrow,sans-serif;font-weight:700;font-size:clamp(2rem,4.2vw,3.2rem);line-height:1.05;letter-spacing:-.01em;color:#1c2024;margin:0 0 1rem;max-width:18ch\">Web Agency a Roma dal 2013, al fianco della crescita del tuo business.</h1><p style=\"font-size:1.05rem;line-height:1.55;color:#52575c;max-width:46ch;margin:0 0 1.75rem\">Comunicazione, web marketing e sviluppo di piattaforme digitali: aiutiamo imprenditori, start up e grandi aziende a crescere, nel privato come nella Pubblica Amministrazione.</p><div style=\"display:flex;gap:1rem;flex-wrap:wrap\"><a href=\"#pricing\" onclick=\"trackClick('crazyweb','preventivo-hero','Preventivo',0)\" style=\"display:inline-flex;align-items:center;font-family:'Archivo Narrow',sans-serif;font-weight:600;font-size:.95rem;padding:.8rem 1.5rem;background:#e8b923;color:#1c2024;text-decoration:none;border-radius:2px\">Richiedi preventivo</a><a href=\"#servizi\" style=\"display:inline-flex;align-items:center;font-family:'Archivo Narrow',sans-serif;font-weight:600;font-size:.95rem;padding:.8rem 1.5rem;border:1px solid #c7ccd1;color:#1c2024;text-decoration:none;border-radius:2px\">Guarda i servizi</a></div></div><div style=\"border-left:1px solid #e4e2da;padding-left:2rem;display:flex;flex-direction:column;gap:1.25rem\"><div><b style=\"display:block;font-family:'Archivo Narrow',sans-serif;font-size:1.9rem;font-weight:700;color:#a07a10;line-height:1\">10+</b><span style=\"display:block;font-size:.8rem;color:#767b80;margin-top:.25rem\">anni di esperienza</span></div><div><b style=\"display:block;font-family:'Archivo Narrow',sans-serif;font-size:1.9rem;font-weight:700;color:#a07a10;line-height:1\">3</b><span style=\"display:block;font-size:.8rem;color:#767b80;margin-top:.25rem\">ambiti di specializzazione</span></div><div><b style=\"display:block;font-family:'Archivo Narrow',sans-serif;font-size:1.9rem;font-weight:700;color:#a07a10;line-height:1\">ROI</b><span style=\"display:block;font-size:.8rem;color:#767b80;margin-top:.25rem\">misurabile e crescita costante</span></div></div></div></section></header>"
