  {
    "id": "pricing",
    "nome": "Preventivo",
    "enabled": true,
    "html": "<section style=\"background:#ffffff;padding:5rem 1.5rem;border-top:1px solid #e4e2da\" id=\"pricing\" aria-labelledby=\"pricing-title\">\n  <div style=\"max-width:1000px;margin:0 auto\">\n    <h2 id=\"pricing-title\" style=\"font-family:'Archivo Narrow',sans-serif;font-weight:700;font-size:clamp(1.9rem,3.2vw,2.6rem);text-align:center;color:#1c2024;margin:0 0 .75rem\">Una consulenza gratuita per iniziare</h2>\n    <p style=\"text-align:center;color:#767b80;font-size:1.05rem;margin:0 0 3rem\">Rispondiamo entro 24 ore, festivi esclusi.</p>\n    <div class=\"eext-pricing\" style=\"display:flex;flex-wrap:wrap;gap:0;border:1px solid #e4e2da\">\n      <div class=\"eext-cell-r\" style=\"flex:1;min-width:260px;padding:2.5rem;border-right:1px solid #e4e2da\">\n        <p style=\"font-family:'Archivo Narrow',sans-serif;font-size:.85rem;letter-spacing:.05em;text-transform:uppercase;color:#767b80;margin:0 0 .75rem\">Progetto singolo</p>\n        <p style=\"font-family:'Archivo Narrow',sans-serif;font-size:1.4rem;font-weight:700;color:#1c2024;margin:0 0 1rem\">Su preventivo</p>\n        <p style=\"font-size:.95rem;color:#4a4f54;line-height:1.6;margin:0 0 1.5rem\">Ideale per un'esigenza specifica: sito, campagna o singolo progetto digitale.</p>\n        <a href=\"#\" onclick=\"trackClick('crazyweb','preventivo-singolo','Progetto singolo',0)\" style=\"display:inline-flex;font-family:'Archivo Narrow',sans-serif;font-weight:600;padding:.75rem 1.5rem;border:1px solid #1c2024;color:#1c2024;text-decoration:none;border-radius:2px\">Richiedi preventivo</a>\n      </div>\n      <div style=\"flex:1;min-width:260px;padding:2.5rem;background:#f4f5f3\">\n        <p style=\"font-family:'Archivo Narrow',sans-serif;font-size:.85rem;letter-spacing:.05em;text-transform:uppercase;color:#a07a10;margin:0 0 .75rem\">Consulenza continuativa</p>\n        <p style=\"font-family:'Archivo Narrow',sans-serif;font-size:1.4rem;font-weight:700;color:#1c2024;margin:0 0 1rem\">Su preventivo</p>\n        <p style=\"font-size:.95rem;color:#4a4f54;line-height:1.6;margin:0 0 1.5rem\">Affiancamento costante su comunicazione, marketing e piattaforme digitali.</p>\n        <a href=\"#\" onclick=\"trackClick('crazyweb','preventivo-manutenzione','Manutenzione',0)\" style=\"display:inline-flex;font-family:'Archivo Narrow',sans-serif;font-weight:600;padding:.75rem 1.5rem;background:#e8b923;color:#1c2024;text-decoration:none;border-radius:2px\">Richiedi preventivo</a>\n      </div>\n    </div>\n  </div>\n</section>"
